# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# IDE
.idea/

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# coverage
coverage/

# Obsidian
# The shared vault config at docs/.obsidian/ IS committed (see the negations
# below) so the whole team gets the same Templates setup. Everything else is
# per-user state, including a stray vault someone creates by opening a
# subfolder instead of docs/ itself.
**/.obsidian/
!docs/.obsidian/
docs/.obsidian/*
!docs/.obsidian/app.json
!docs/.obsidian/core-plugins.json
!docs/.obsidian/templates.json
